; Officium reference score, sung form (§7.3): the same three-mode
; planetary defense as meteor.off, but each verse in the liturgical
; eight lines. A line is `label "sung text" ; statement` — the text is
; what the choir sings, the statement is what it means.
;
; Rhyme = type (§7.4): lines sharing a label must carry unifiable
; statement types, and the checker verifies it before a note sounds.
; Hence the sequence-like schemes below — every rhyme is honest:
; A-lines answer each other with the same type (the antiphon lines
; echo a value back), and the final couplet carries the verse's
; result. The volta falls between line 6 and line 7.
; The fugue is not sung — the organ holds it (§4.2).

fuga gravitas in Sol {
  pedale     G = 6.674e-11                ; grav. constant, held in the pedals
  subiectum  trahere(corpus) = \r -> G * mass(corpus) / (r * r)
  reale      trahere @ asteroides = \r -> G * mass(corpus) / (r * r)
  tonale     trahere @ cometes    = \r -> (G * mass(corpus) / (r * r)) + outgassing(corpus)
  contra     \r -> r * r                  ; r-squared always sounds with the subject
}

; scheme AABCCB DD: A = the body (corpus), B = force numbers,
; C = distance numbers, D = the couplet (the verse's Field / nihil)
versus correctio in Re {
  A "Corpus errans in caelo videtur"      ; corpus <- arg
  A "Et a choro testis intuetur"          ; testis <- pure corpus
  B "Vis attractionis pedale sonat"       ; g <- ask "G"
  C "Quam longinqua via mensuratur"       ; r <- pure (dist corpus)
  C "Quadratum viae contra cantatur"      ; via <- pure (r * r)
  B "Modus trahendi genus coronat"        ; dv <- pure (solve (resolve "trahere" (genus corpus)) r)
  D "Si tutum silet vox in aeternum"      ; si (safe corpus g) tunc { nihil } aliter {
  D "Sin flectat caelum iter externum"    ; amen (deflect dv) }
}

; scheme AABBCC DD: A = the field, B = its numbers, C = the command,
; D = the couplet (the pure result, nothing yet moved)
versus consilium in sol {
  A "Campus purus in manus traditur"      ; field <- arg
  A "Pignus fidele choro redditur"        ; pignus <- pure field
  B "Cui corpori vis dirigenda"           ; t <- pure (target field)
  B "Et quanta virtus imponenda"          ; d <- pure (dv_of field)
  C "Iussum e campo iam formatur"         ; iussum <- pure (cmd t d (at field))
  C "In librum consilii mittatur"         ; mitte iussum
  D "Nihil adhuc in mundo motum est"      ; quies <- pure verum
  D "Consilium purum perfectum est"       ; amen field
}

; scheme AABBCC DD: A = the plan, B and C = the doxology,
; D = the couplet — the commit, the only impure act
versus executio in Sol {
  A "Consilium plenum accipitur"          ; plan <- arg
  A "Pignus ultimum custoditur"           ; pignus <- pure plan
  B "Gloria Patri qui fundavit"           ; gloria <- pure "patri"
  B "Et Filio qui nos salvavit"           ; laus <- pure "filio"
  C "Spiritui vivificanti"                ; honor <- pure "spiritui"
  C "Laude aeterna resonanti"             ; iubilus <- pure "saecula"
  D "Per omnia saecula saeculorum"        ; finis <- pure "amen"
  D "Perage - fiat opus manuum"           ; perage plan
}
